# PayPilot AI - Environment Configuration

# Server Settings
APP_NAME="PayPilot AI"
APP_ENV="development"
DATABASE_URL="sqlite:///./paypilot.db"

# PayPal Developer Sandbox Credentials
# Obtain at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="YOUR_PAYPAL_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_SANDBOX_CLIENT_SECRET"
PAYPAL_MODE="sandbox"
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID=""

# AI Provider (Google Gemini API)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Safety Limits
MAX_AUTONOMOUS_PAYOUT_AMOUNT="100.00"
MAX_SINGLE_TRANSACTION_LIMIT="5000.00"
REQUIRE_APPROVAL_DEFAULT="true"
